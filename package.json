{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "docs-docusaurus",
    "version": "1.0.0",
    "private": true,
    "description": "Documentation site for Uptime Watcher using Docusaurus",
    "keywords": [
        "docusaurus",
        "documentation",
        "uptime",
        "monitoring",
        "electron"
    ],
    "homepage": "https://nick2bad4u.github.io/Uptime-Watcher/",
    "bugs": {
        "url": "https://github.com/Nick2bad4u/Uptime-Watcher/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nick2bad4u/Uptime-Watcher-Docusaurus.git"
    },
    "license": "UNLICENSED",
    "author": "Nick2bad4u",
    "contributors": [
        {
            "name": "Nick2bad4u",
            "url": "https://github.com/Nick2bad4u"
        }
    ],
    "type": "module",
    "scripts": {
        "build": "npm run generate-docs && npm run --prefix ../.. build:eslint-inspector && npm run build:default",
        "build:default": "docusaurus build",
        "build:fast": "node ../../scripts/run-node-cli.mjs DOCUSAURUS_ENABLE_EXPERIMENTAL=true -- docusaurus build",
        "build:local": "npm run generate-docs:local && npm run --prefix ../.. build:eslint-inspector && npm run build:default",
        "changelog:generate": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --output CHANGELOG.md",
        "changelog:preview": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --unreleased",
        "changelog:release-notes": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --current",
        "clear": "docusaurus clear",
        "css:types": "node -e \"const { run } = require('typed-css-modules/lib/run'); run('src', { pattern: '**/*.module.css' }).catch((error) => { console.error(error); process.exit(1); });\"",
        "css:types:check": "node -e \"const { run } = require('typed-css-modules/lib/run'); run('src', { listDifferent: true, pattern: '**/*.module.css' }).catch((error) => { console.error(error); process.exit(1); });\"",
        "deploy": "docusaurus deploy",
        "docs:api": "typedoc --options typedoc.config.json",
        "docusaurus": "docusaurus",
        "format": "npm run lint:fix && npm run lint:css:fix",
        "format:check": "npm run lint && npm run lint:css",
        "generate-docs": "npm run generate-docs:default",
        "generate-docs:app": "typedoc --options ../../typedoc.json",
        "generate-docs:default": "node ../../scripts/run-typedoc-safe.mjs docs/docusaurus/typedoc.config.json",
        "generate-docs:electron": "typedoc --options ../../typedoc.electron.json",
        "generate-docs:local": "node ../../scripts/run-typedoc-safe.mjs docs/docusaurus/typedoc.local.config.json",
        "lint": "npm run --prefix ../.. lint:docusaurus",
        "lint:css": "stylelint \"src/**/*.css\" --cache --config stylelint.config.mjs --ignore-path .stylelintignore --cache-strategy content --cache-location .stylelintcache --formatter=verbose",
        "lint:css:fix": "stylelint \"src/**/*.css\" --cache --config stylelint.config.mjs --ignore-path .stylelintignore --cache-strategy content --cache-location .stylelintcache --formatter=verbose --fix",
        "lint:fix": "npm run --prefix ../.. lint:docusaurus -- --fix",
        "lint:gitleaks": "gitleaks dir --config .gitleaks.toml .",
        "lint:jscpd": "jscpd --config node_modules/jscpd-config-nick2bad4u/jscpd.json",
        "lint:lychee": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml .",
        "lint:lychee:smoke": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml --dump-inputs README.md",
        "lint:package-json": "npmPkgJsonLint . --config .npmpackagejsonlintrc.json",
        "lint:prettier": "prettier . --log-level warn --cache --cache-location=.cache/.prettier-cache --cache-strategy=content --check",
        "lint:prettier:fix": "prettier . --log-level warn --cache --cache-location=.cache/.prettier-cache --cache-strategy=content --write",
        "lint:remark": "remark . --frail --ignore-path .remarkignore",
        "lint:remark:fix": "remark . --ignore-path .remarkignore --output",
        "lint:secretlint": "secretlint --secretlintrc .secretlintrc.cjs --secretlintignore .gitignore \"**/*\"",
        "lint:yamllint": "yamllint -c .yamllint .",
        "serve": "docusaurus serve",
        "start": "docusaurus start",
        "swizzle": "docusaurus swizzle",
        "type-check": "npm run typecheck",
        "typecheck": "npm run typecheck:build && npm run css:types:check",
        "typecheck:build": "tsc --project tsconfig.json --noEmit",
        "update-deps": "ncu --configFileName .ncurc.json --configFilePath node_modules/ncu-config-nick2bad4u && npm update --force && npm install --force",
        "write-heading-ids": "docusaurus write-heading-ids",
        "write-translations": "docusaurus write-translations"
    },
    "overrides": {
        "copy-webpack-plugin": {
            "serialize-javascript": "^7.0.7"
        },
        "css-minimizer-webpack-plugin": {
            "serialize-javascript": "^7.0.7"
        },
        "minimatch@3.1.2": {
            "brace-expansion": "^1.1.15"
        },
        "sockjs": {
            "uuid": "^11.1.1"
        }
    },
    "devDependencies": {
        "@docusaurus/core": "^3.10.2",
        "@docusaurus/eslint-plugin": "^3.10.2",
        "@docusaurus/faster": "^3.10.2",
        "@docusaurus/module-type-aliases": "^3.10.2",
        "@docusaurus/plugin-content-docs": "^3.10.2",
        "@docusaurus/plugin-pwa": "^3.10.2",
        "@docusaurus/preset-classic": "^3.10.2",
        "@docusaurus/theme-live-codeblock": "^3.10.2",
        "@docusaurus/theme-mermaid": "^3.10.2",
        "@docusaurus/tsconfig": "^3.10.2",
        "@docusaurus/types": "^3.10.2",
        "@easyops-cn/docusaurus-search-local": "^0.55.2",
        "@eslint/config-inspector": "^3.0.4",
        "@mdx-js/react": "^3.1.1",
        "@microsoft/tsdoc-config": "^0.18.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "clsx": "^2.1.1",
        "docusaurus-plugin-copy-page-button": "^0.8.4",
        "docusaurus-plugin-image-zoom": "^3.0.1",
        "docusaurus-plugin-llms": "^0.4.0",
        "git-cliff": "^2.13.1",
        "gitcliff-config-nick2bad4u": "^1.3.0",
        "gitleaks-config-nick2bad4u": "^1.0.4",
        "jscpd": "^5.0.12",
        "jscpd-config-nick2bad4u": "^1.1.0",
        "lychee-config-nick2bad4u": "^2.0.0",
        "ncu-config-nick2bad4u": "^0.2.0",
        "npm-check-updates": "^22.2.9",
        "npm-package-json-lint": "^10.4.1",
        "npm-package-json-lint-config-nick2bad4u": "^1.0.4",
        "prettier": "^3.9.5",
        "prettier-config-nick2bad4u": "^1.1.1",
        "prism-react-renderer": "^2.4.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-github-btn": "^1.4.0",
        "remark": "^15.0.1",
        "remark-cli": "^12.0.1",
        "remark-config-nick2bad4u": "^1.1.3",
        "secretlint": "^13.0.2",
        "secretlint-config-nick2bad4u": "^1.1.2",
        "stylelint": "^17.14.0",
        "stylelint-config-nick2bad4u": "^1.0.20",
        "tsdoc-config-nick2bad4u": "^1.0.6",
        "typed-css-modules": "^0.9.1",
        "typedoc": "^0.28.20",
        "typedoc-config-nick2bad4u": "^2.0.3",
        "typescript": "^6.0.3",
        "yamllint-config-nick2bad4u": "^1.1.1"
    },
    "engines": {
        "node": ">=18.0"
    },
    "preferGlobal": false
}
